{
    "manifest_version": 3,
    "name": "RefineAI: AI Rewriter, Grammar Checker & Paraphraser",
    "version": "1.2",
    "description": "Rewrite any text instantly. An AI writing assistant to paraphrase sentences, fix grammar, and change tone in Gmail, LinkedIn, and more.",
    "permissions": [
        "sidePanel",
        "contextMenus",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://*.supabase.co/*",
        "https://*.razorpay.com/*",
        "https://*.lemonsqueezy.com/*",
        "https://*.stripe.com/*",
        "https://web.whatsapp.com/*",
        "https://www.linkedin.com/*",
        "https://mail.google.com/*",
        "https://chat.google.com/*",
        "https://app.slack.com/*",
        "https://*.slack.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open Side Panel"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://web.whatsapp.com/*",
                "https://www.linkedin.com/*",
                "https://mail.google.com/*",
                "https://chat.google.com/*",
                "https://app.slack.com/*",
                "https://*.slack.com/*"
            ],
            "js": [
                "features/content.js"
            ]
        }
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+R"
            },
            "description": "Open RefineAI panel"
        }
    }
}